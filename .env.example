# Database Configuration for Render with Connection Pooling
# For production, use optimized connection parameters to prevent connection limit issues
DATABASE_URL="postgresql://actingeurope_user:p1EOPq8RfGjCEN7MqPcKehFVOucDRrTn@dpg-d2a8sfer433s73a7rm0g-a/actingeurope?connection_limit=5&pool_timeout=20&connect_timeout=60"

# Example for Render PostgreSQL with connection optimization:
# DATABASE_URL="postgresql://username:password@host/database?connection_limit=5&pool_timeout=20&connect_timeout=60"
# 
# Connection parameters explanation:
# - connection_limit=5: Limits concurrent connections (adjust based on your plan)
# - pool_timeout=20: Time to wait for connection from pool (seconds)
# - connect_timeout=60: Time to wait for initial connection (seconds)

