generator client {
  provider = "prisma-client-js"
  output   = "../lib/prisma-client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String    @id @db.Uuid
  email                 String    @unique @db.VarChar(255)
  first_name            String    @db.VarChar(100)
  last_name             String    @db.VarChar(100)
  phone                 String?   @db.VarChar(20)
  is_admin              Boolean   @default(false)
  email_notifications   Boolean   @default(true)
  marketing_preferences Boolean   @default(false)
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  bookings              Booking[]

  @@map("users")
}

model Theatre {
  id                Int            @id @default(autoincrement())
  name              String         @db.VarChar(255)
  city              String         @db.VarChar(100)
  country           String         @db.VarChar(100)
  description       String?
  history           String?
  website           String?        @db.VarChar(255)
  founded_year      Int?
  content_language  String         @default("en") @db.VarChar(5)
  translation_group String?        @db.VarChar(100)
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt
  photos            String[]       @default([])
  events            Event[]
  images            TheatreImage[]
  tags              TheatreTag[]

  @@map("theatres")
}

model TheatreImage {
  id         Int      @id @default(autoincrement())
  theatre_id Int
  image_url  String   @db.VarChar(500)
  caption    String?  @db.VarChar(255)
  is_primary Boolean  @default(false)
  created_at DateTime @default(now())
  theatre    Theatre  @relation(fields: [theatre_id], references: [id], onDelete: Cascade)

  @@map("theatre_images")
}

model TheatreTag {
  id         Int      @id @default(autoincrement())
  theatre_id Int
  tag_name   String   @db.VarChar(100)
  created_at DateTime @default(now())
  theatre    Theatre  @relation(fields: [theatre_id], references: [id], onDelete: Cascade)

  @@map("theatre_tags")
}

model Venue {
  id          Int            @id @default(autoincrement())
  name        String         @db.VarChar(100)
  description String?
  address     String?        @db.VarChar(255)
  city        String?        @db.VarChar(100)
  capacity    Int
  image_url   String?        @db.VarChar(500)
  created_at  DateTime       @default(now())
  events      Event[]
  sections    VenueSection[]

  @@map("venues")
}

model VenueSection {
  id           Int         @id @default(autoincrement())
  venue_id     Int
  section_name String      @db.VarChar(50)
  section_type SectionType
  created_at   DateTime    @default(now())
  seats        Seat[]
  venue        Venue       @relation(fields: [venue_id], references: [id], onDelete: Cascade)

  @@map("venue_sections")
}

model Seat {
  id               Int          @id @default(autoincrement())
  venue_section_id Int
  row_number       Int
  seat_number      Int
  is_available     Boolean      @default(true)
  is_accessible    Boolean      @default(false)
  created_at       DateTime     @default(now())
  booked_seats     BookedSeat[]
  venueSection     VenueSection @relation(fields: [venue_section_id], references: [id], onDelete: Cascade)

  @@unique([venue_section_id, row_number, seat_number], name: "unique_seat")
  @@map("seats")
}

model Event {
  id                   Int       @id @default(autoincrement())
  title                String    @db.VarChar(255)
  theatre_id           Int
  venue_id             Int?
  event_type           EventType
  event_date           DateTime  @db.Date
  event_time           DateTime  @db.Time(3)
  description          String?
  price                Decimal   @db.Decimal(10, 2)
  image_url            String?   @db.VarChar(500)
  poster_url           String?   @db.VarChar(500)
  language             String?   @db.VarChar(50)
  content_language     String    @default("en") @db.VarChar(5)
  translation_group    String?   @db.VarChar(100)
  performance_language String?   @db.VarChar(50)
  subtitle_language    String?   @db.VarChar(50)
  genre                String?   @db.VarChar(100)
  company              String[]  @default([])
  director             String?   @db.VarChar(255)
  cast                 String[]  @default([])
  subtitles            String?   @db.VarChar(255)
  duration             String?   @db.VarChar(100)
  is_featured          Boolean   @default(false)
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  bookings             Booking[]
  theatre              Theatre   @relation(fields: [theatre_id], references: [id])
  venue                Venue?    @relation(fields: [venue_id], references: [id])

  @@map("events")
}

model Booking {
  id                Int           @id @default(autoincrement())
  user_id           String        @db.Uuid
  event_id          Int
  booking_reference String        @unique @db.VarChar(50)
  total_amount      Decimal       @db.Decimal(10, 2)
  booking_status    BookingStatus @default(pending)
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
  attendee_names    Json?
  booked_seats      BookedSeat[]
  event             Event         @relation(fields: [event_id], references: [id])
  user              User          @relation(fields: [user_id], references: [id])

  @@map("bookings")
}

model BookedSeat {
  id            Int       @id @default(autoincrement())
  booking_id    Int
  seat_id       Int
  created_at    DateTime  @default(now())
  attendee_name String?
  qr_code_data  String?
  scanned_at    DateTime?
  booking       Booking   @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  seat          Seat      @relation(fields: [seat_id], references: [id])

  @@unique([booking_id, seat_id], name: "unique_booked_seat")
  @@index([booking_id])
  @@index([seat_id])
  @@map("booked_seats")
}

model NewsArticle {
  id                Int       @id @default(autoincrement())
  title             String    @db.VarChar(255)
  excerpt           String?
  content           String
  category          String?   @db.VarChar(100)
  image_url         String?   @db.VarChar(500)
  author            String?   @db.VarChar(100)
  content_language  String    @default("en") @db.VarChar(5)
  translation_group String?   @db.VarChar(100)
  published_at      DateTime?
  is_published      Boolean   @default(false)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  @@map("news_articles")
}

model AboutPage {
  id                Int      @id @default(autoincrement())
  title             String   @db.VarChar(255)
  content           String
  mission           String?
  vision            String?
  history           String?
  image_url         String?  @db.VarChar(500)
  content_language  String   @default("en") @db.VarChar(5)
  translation_group String?  @db.VarChar(100)
  is_published      Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@map("about_pages")
}

model ContactPage {
  id                Int      @id @default(autoincrement())
  title             String   @db.VarChar(255)
  content           String
  address           String?
  phone             String?  @db.VarChar(50)
  email             String?  @db.VarChar(255)
  office_hours      String?
  map_embed         String?
  content_language  String   @default("en") @db.VarChar(5)
  translation_group String?  @db.VarChar(100)
  is_published      Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@map("contact_pages")
}

enum SectionType {
  regular
  balcony
}

enum EventType {
  performance
  workshop
  discussion
}

enum BookingStatus {
  pending
  confirmed
  cancelled
}
