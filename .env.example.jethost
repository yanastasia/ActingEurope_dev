# JEThost (cPanel Node.js App) environment configuration
#
# How to use:
# - Preferred: Set these as Environment Variables in cPanel → Setup Node.js App.
# - Alternative: Copy this file to `.env.production` on the server root.
#   Ensure `NODE_ENV=production` and use `npm run start:server`.

# Runtime
NODE_ENV=production
PORT=3000

# Public app URL
NEXT_PUBLIC_APP_URL=https://your-domain.tld

# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Database (Prisma / Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public
DIRECT_URL=postgresql://user:password@host:5432/dbname?schema=public

# Authentication
NEXTAUTH_URL=https://your-domain.tld
# Recommended in production; generate a strong secret:
# NEXTAUTH_SECRET=your-generated-secret

# Email sending
SEND_EMAILS=true
EMAIL_FROM=info@your-domain.tld

# Postmark (preferred email provider)
POSTMARK_SERVER_TOKEN=your-postmark-server-token
# If you use API key style:
POSTMARK_API_KEY=your-postmark-api-key
POSTMARK_VERIFICATION_TEMPLATE_ALIAS=confirm-sign-up-for-acting-eur
POSTMARK_VERIFICATION_TEMPLATE_ID=your-verification-template-id
POSTMARK_TICKET_SERVER_TOKEN=your-postmark-ticket-server-token
POSTMARK_TICKET_TEMPLATE_ALIAS=ticket-delivery-acting-europe
POSTMARK_TICKET_FROM_EMAIL=tickets@your-domain.tld

# SMTP fallback (if not using Postmark)
EMAIL_SERVER_USER=smtp-user
EMAIL_SERVER_PASSWORD=smtp-password

# Supabase service role (backend/admin operations only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key